SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
ALLOW_DEBUG_OTP=false
RESEND_API_KEY=re_replace_with_vercel_secret
EMAIL_FROM=Employee Portal <no-reply@example.com>


# For Vercel, leave VITE_API_URL unset so the frontend uses the same-origin /api path.
# Set FRONTEND_ORIGIN only when the frontend is hosted on a different origin.