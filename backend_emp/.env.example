# Server Config
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database / Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
ALLOW_DEBUG_OTP=false

# Email Delivery (Resend / SMTP)
RESEND_API_KEY=re_replace_with_resend_api_key
# The domain after @ must be verified in Resend before production use.
EMAIL_FROM=Employee Portal <no-reply@example.com>

# Zoho Integration Configuration (OAuth)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Option A: Zoho Books Integration
ZOHO_BOOKS_ORGANIZATION_ID=your_zoho_books_organization_id_here
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3

# Option B: Zoho CRM Custom Module Integration
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_CUSTOM_MODULE_API_NAME=Employees_Custom_Module
