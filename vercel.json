{
  "version": 2,
  "builds": [
    {
      "src": "backend_emp/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend_emp/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend_emp/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend_emp/assets/$1"
    },
    {
      "src": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|json|map))",
      "dest": "frontend_emp/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend_emp/index.html"
    }
  ]
}
